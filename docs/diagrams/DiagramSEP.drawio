        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% ACTORS (Đặt bên ngoài hệ thống)\n    Guest([\&quot;Guest\&quot;])\n    AuthUser([\&quot;Authenticated User\&quot;])\n    Citizen([\&quot;Registered Citizen\&quot;])\n    Officer([\&quot;Front-desk Officer\&quot;])\n    Manager([\&quot;Manager\&quot;])\n    ProcManager([\&quot;Procedure Manager\&quot;])\n    Admin([\&quot;IT Admin\&quot;])\n\n    %% INHERITANCE (Các Role kế thừa từ Authenticated User)\n    Citizen -. \&quot;&lt;&lt; inherits &gt;&gt;\&quot; .-&gt; AuthUser\n    Officer -. \&quot;&lt;&lt; inherits &gt;&gt;\&quot; .-&gt; AuthUser\n    Manager -. \&quot;&lt;&lt; inherits &gt;&gt;\&quot; .-&gt; AuthUser\n    ProcManager -. \&quot;&lt;&lt; inherits &gt;&gt;\&quot; .-&gt; AuthUser\n    Admin -. \&quot;&lt;&lt; inherits &gt;&gt;\&quot; .-&gt; AuthUser\n\n    subgraph WardMate [\&quot;WardMate System Boundary\&quot;]\n        direction TB\n        \n        %% AUTHENTICATION (Dùng chung)\n        UC1([1. Sign In])\n        UC2([2. Logout])\n\n        %% GUEST &amp; SHARED\n        UC3([3. Sign Up])\n        UC6([6. Search Procedure])\n        UC7([7. View Procedure Details])\n        UC8([8. Download Blank Form])\n        UC9([9. Chat with AI Assistant])\n\n        %% CITIZEN\n        UC4([4. View Profile])\n        UC5([5. Update Profile])\n        UC10([10. View Applications])\n        UC11([11. View Application Detail])\n        UC12([12. Create Application])\n        UC13([13. Cancel Application])\n        UC14([14. View Checklist])\n        UC15([15. Update Checklist])\n        UC16([16. Upload Document])\n        UC17([17. Delete Document])\n        UC18([18. Fill E-form])\n        UC19([19. Generate PDF])\n        UC20([20. Submit Application])\n        UC21([21. Revise Application])\n        UC22([22. Scan QR to Print])\n        UC23([23. Create Feedback])\n\n        %% OFFICER\n        UC24([24. View Pending Applications])\n        UC25([25. Preview Application])\n        UC26([26. Request Revision])\n        UC27([27. Approve Application])\n\n        %% MANAGER\n        UC28([28. View System Statistics])\n        UC29([29. View Feedback Reports])\n\n        %% PROCEDURE MANAGER\n        UC30([30. View Procedures])\n        UC31([31. Create Procedure])\n        UC32([32. Update Procedure])\n        UC33([33. Delete Procedure])\n        UC34([34. View Form Templates])\n        UC35([35. Create Form Template])\n        UC36([36. Update Form Template])\n        UC37([37. Delete Form Template])\n\n        %% IT ADMIN\n        UC38([38. View Internal Accounts])\n        UC39([39. Create Internal Account])\n        UC40([40. Update Internal Account])\n        UC41([41. Ban/Disable Account])\n        UC42([42. View Audit Logs])\n\n        %% INTERNAL RELATIONSHIPS (Includes / Extends)\n        UC18 -. \&quot;&lt;&lt; include &gt;&gt;\&quot; .-&gt; UC19\n        UC21 -. \&quot;&lt;&lt; extend &gt;&gt;\&quot; .-&gt; UC20\n        UC26 -. \&quot;&lt;&lt; extend &gt;&gt;\&quot; .-&gt; UC25\n        UC27 -. \&quot;&lt;&lt; extend &gt;&gt;\&quot; .-&gt; UC25\n    }\n\n    %% KẾT NỐI ACTOR -&gt; USE CASE\n    \n    %% Base Auth User\n    AuthUser --- UC1\n    AuthUser --- UC2\n\n    %% Guest\n    Guest --- UC3\n    Guest --- UC6\n    Guest --- UC7\n    Guest --- UC8\n    Guest --- UC9\n\n    %% Citizen\n    Citizen --- UC4\n    Citizen --- UC5\n    Citizen --- UC6\n    Citizen --- UC7\n    Citizen --- UC8\n    Citizen --- UC9\n    Citizen --- UC10\n    Citizen --- UC11\n    Citizen --- UC12\n    Citizen --- UC13\n    Citizen --- UC14\n    Citizen --- UC15\n    Citizen --- UC16\n    Citizen --- UC17\n    Citizen --- UC18\n    Citizen --- UC20\n    Citizen --- UC21\n    Citizen --- UC22\n    Citizen --- UC23\n\n    %% Officer\n    Officer --- UC24\n    Officer --- UC25\n\n    %% Manager\n    Manager --- UC28\n    Manager --- UC29\n\n    %% Procedure Manager\n    ProcManager --- UC30\n    ProcManager --- UC31\n    ProcManager --- UC32\n    ProcManager --- UC33\n    ProcManager --- UC34\n    ProcManager --- UC35\n    ProcManager --- UC36\n    ProcManager --- UC37\n\n    %% IT Admin\n    Admin --- UC38\n    Admin --- UC39\n    Admin --- UC40\n    Admin --- UC41\n    Admin --- UC42&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="F8wrxHaERQEZjuFda-H_-2">
