%% Analytics System - Run System Operations
%% Dashed actions are planned; see README.md for partial implementations.
flowchart TD
  start((" ")):::initial
  kind{"Operation Type?"}:::decision
  audit("Receive Audit or Settings Request"):::planned
  health("Check Service Health"):::planned
  backup("Create Database Backup"):::planned
  sanitize("Validate Access and Sanitize Data"):::planned
  history("Record Health and Raise Alerts"):::planned
  verify{"Backup Valid?"}:::decision
  store("Save Audit or Settings"):::planned
  failure("Record Backup Error"):::planned
  retention("Store Backup Metadata"):::planned
  restore("Verify Restore in Isolation"):::planned
  merge{" "}:::merge
  ActivityFinal(((" "))):::final
  start --> kind
  kind -->|"Audit / Settings"| audit
  kind -->|"Health"| health
  kind -->|"Backup"| backup
  audit --> sanitize
  sanitize --> store
  health --> history
  history --> merge
  backup --> verify
  verify -->|"No"| failure
  verify -->|"Yes"| retention
  retention --> restore
  restore --> merge
  failure --> merge
  store --> merge
  merge --> ActivityFinal
  classDef initial fill:#111,stroke:#111,color:#111;
  classDef final fill:#111,stroke:#111,color:#111;
  classDef action fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef decision fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef merge fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef planned fill:#7ed0eb,stroke:#45525e,color:#162b3b,stroke-dasharray:6 4;
  classDef external fill:#eeeeee,stroke:#666,color:#162b3b;
  classDef partial fill:#7ed0eb,stroke:#b7791f,stroke-width:2px,color:#162b3b;
