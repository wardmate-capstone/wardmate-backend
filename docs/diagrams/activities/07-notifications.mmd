%% Analytics System - Deliver Notifications
%% Dashed actions are planned; see README.md for partial implementations.
flowchart TD
  start((" ")):::initial
  inbox("Receive and Store Event"):::action
  recipient("Find Recipients"):::action
  eligible{"Recipient Eligible?"}:::decision
  suppressed("Suppress Delivery"):::action
  delivery("Create Notification"):::action
  channel{"Delivery Channel?"}:::decision
  inapp("Send In-App Notification"):::action
  email("Send Email"):::partial
  sms("Send SMS"):::planned
  sendMerge{" "}:::merge
  sent{"Send Successful?"}:::decision
  fail("Block or Retry Delivery"):::action
  success("Record Send Status"):::action
  receipt("Process Provider Receipt"):::planned
  merge{" "}:::merge
  ActivityFinal(((" "))):::final
  start --> inbox
  inbox --> recipient
  recipient --> eligible
  eligible -->|"No"| suppressed
  suppressed --> merge
  eligible -->|"Yes"| delivery
  delivery --> channel
  channel -->|"IN_APP"| inapp
  channel -->|"EMAIL"| email
  channel -->|"SMS"| sms
  inapp --> sendMerge
  email --> sendMerge
  sms --> sendMerge
  sendMerge --> sent
  sent -->|"No"| fail
  sent -->|"Yes"| success
  success --> receipt
  receipt --> merge
  fail --> merge
  merge --> ActivityFinal
  classDef initial fill:#111,stroke:#111,color:#111;
  classDef final fill:#111,stroke:#111,color:#111;
  classDef action fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef decision fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef merge fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef planned fill:#7ed0eb,stroke:#45525e,color:#162b3b,stroke-dasharray:6 4;
  classDef external fill:#eeeeee,stroke:#666,color:#162b3b;
  classDef partial fill:#7ed0eb,stroke:#b7791f,stroke-width:2px,color:#162b3b;
