%% Document Form - Prepare Documents
%% Target scope only. Backend changes pending. Ward visit is outside WardMate.
%% Dashed actions are planned; see README.md for partial implementations.
flowchart TD
  start((" ")):::initial
  template("Create Form Template"):::action
  fill("Complete Form"):::action
  link("Save and Link Documents"):::action
  approved{"Document Readiness Confirmed?"}:::decision
  block("Request Document Review"):::planned
  clean("Prepare Clean Document"):::planned
  qrMode{"Output Type?"}:::decision
  qr("Insert Preparation Reference QR"):::planned
  renderMerge{" "}:::merge
  render("Convert Document to PDF"):::action
  success{"Valid PDF?"}:::decision
  error("Display Conversion Error"):::action
  store("Store Prepared PDF"):::action
  event("Publish Preparation Event"):::planned
  merge{" "}:::merge
  ActivityFinal(((" "))):::final
  start --> template
  template --> fill
  fill --> link
  link --> approved
  approved -->|"No"| block
  block --> merge
  approved -->|"Yes"| clean
  clean --> qrMode
  qrMode -->|"With QR"| qr
  qrMode -->|"PDF Only"| renderMerge
  qr --> renderMerge
  renderMerge --> render
  render --> success
  success -->|"No"| error
  success -->|"Yes"| store
  error --> merge
  store --> event
  event --> merge
  merge --> ActivityFinal
  classDef initial fill:#111,stroke:#111,color:#111;
  classDef final fill:#111,stroke:#111,color:#111;
  classDef action fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef decision fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef merge fill:#7ed0eb,stroke:#45525e,color:#162b3b;
  classDef planned fill:#7ed0eb,stroke:#45525e,color:#162b3b,stroke-dasharray:6 4;
  classDef external fill:#eeeeee,stroke:#666,color:#162b3b;
  classDef partial fill:#7ed0eb,stroke:#b7791f,stroke-width:2px,color:#162b3b;
