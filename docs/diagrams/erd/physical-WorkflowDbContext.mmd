erDiagram
    WF_applications ||--o{ WF_application_assignment_history : "FK application_id"
    WF_applications ||--o{ WF_application_checklists : "FK application_id"
    WF_applications ||--o{ WF_application_status_history : "FK application_id"
    WF_applications ||--o{ WF_application_versions : "FK application_id"
    WF_application_versions ||--o{ WF_application_comments : "FK application_id+application_version_id"
    WF_applications ||--o{ WF_application_comments : "FK application_id"
    WF_applications {
        uuid id PK "uuid NOT NULL"
        character_varying(50) application_code UK "character varying(50) NOT NULL"
        uuid user_id "uuid NOT NULL"
        uuid procedure_id "uuid NOT NULL"
        character_varying(50) ward_code "character varying(50) NULL"
        character_varying(500) procedure_title "character varying(500) NOT NULL"
        integer category_id "integer NULL"
        character_varying(255) category_name "character varying(255) NULL"
        character_varying(255) assigned_officer_name "character varying(255) NULL"
        timestamp_with_time_zone assigned_at "timestamp with time zone NULL"
        bigint assignment_version "bigint NOT NULL DEFAULT 0"
        character_varying(100) case_code "character varying(100) NULL"
        character_varying(50) status "character varying(50) NOT NULL DEFAULT 'DRAFT'"
        jsonb form_data "jsonb NOT NULL"
        timestamp_with_time_zone submitted_at "timestamp with time zone NULL"
        timestamp_with_time_zone first_submitted_at_utc "timestamp with time zone NULL"
        timestamp_with_time_zone due_at_utc "timestamp with time zone NULL"
        character_varying(20) deadline_status "character varying(20) NOT NULL DEFAULT 'UNKNOWN'"
        character_varying(100) deadline_policy_code "character varying(100) NULL"
        character_varying(100) deadline_policy_version "character varying(100) NULL"
        character_varying(100) deadline_calendar_code "character varying(100) NULL"
        character_varying(100) deadline_calendar_version "character varying(100) NULL"
        jsonb deadline_policy_snapshot "jsonb NULL"
        timestamp_with_time_zone deadline_paused_at_utc "timestamp with time zone NULL"
        jsonb deadline_history "jsonb NOT NULL DEFAULT '[]'"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
        timestamp_with_time_zone updated_at "timestamp with time zone NOT NULL"
        uuid assigned_officer_id "uuid NULL"
        integer resubmit_count "integer NOT NULL DEFAULT 0"
        text notes "text NULL"
        timestamp_with_time_zone approved_at "timestamp with time zone NULL"
        timestamp_with_time_zone documents_ready_at "timestamp with time zone NULL"
        character_varying(64) receipt_number UK "character varying(64) NULL"
        timestamp_with_time_zone received_at "timestamp with time zone NULL"
        timestamp_with_time_zone appointment_date "timestamp with time zone NULL"
    }
    WF_workflow_outbox {
        uuid id PK "uuid NOT NULL"
        jsonb payload "jsonb NOT NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
        timestamp_with_time_zone next_attempt_at "timestamp with time zone NOT NULL"
        timestamp_with_time_zone published_at "timestamp with time zone NULL"
        integer attempts "integer NOT NULL"
        character_varying(100) last_error "character varying(100) NULL"
    }
    WF_application_assignment_history {
        uuid id PK "uuid NOT NULL"
        uuid application_id FK "uuid NOT NULL"
        character_varying(20) action "character varying(20) NOT NULL"
        uuid from_officer_id "uuid NULL"
        uuid to_officer_id "uuid NULL"
        uuid actor_id "uuid NOT NULL"
        character_varying(500) reason "character varying(500) NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
    }
    WF_application_checklists {
        uuid id PK "uuid NOT NULL"
        integer sort_order "integer NOT NULL"
        text case_code "text NULL"
        character_varying(30) submission_type "character varying(30) NULL"
        character_varying(30) document_copy_type "character varying(30) NULL"
        integer quantity "integer NOT NULL DEFAULT 1"
        text condition_note "text NULL"
        uuid form_template_id "uuid NULL"
        uuid application_id FK "uuid NOT NULL"
        character_varying(255) code "character varying(255) NOT NULL"
        character_varying(255) title "character varying(255) NOT NULL"
        boolean is_required "boolean NOT NULL"
        character_varying(30) status "character varying(30) NOT NULL DEFAULT 'PENDING'"
        character_varying(500) file_url "character varying(500) NULL"
        character_varying(4000) note "character varying(4000) NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
        timestamp_with_time_zone updated_at "timestamp with time zone NOT NULL"
    }
    WF_application_status_history {
        uuid id PK "uuid NOT NULL"
        uuid application_id FK "uuid NOT NULL"
        character_varying(50) from_status "character varying(50) NULL"
        character_varying(50) to_status "character varying(50) NOT NULL"
        uuid changed_by "uuid NOT NULL"
        text reason "text NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL DEFAULT (CURRENT_TIMESTAMP)"
    }
    WF_application_versions {
        uuid id PK "uuid NOT NULL"
        uuid application_id FK "uuid NOT NULL"
        integer version_number "integer NOT NULL"
        uuid submitted_by "uuid NOT NULL"
        timestamp_with_time_zone submitted_at "timestamp with time zone NOT NULL"
        jsonb snapshot_data "jsonb NOT NULL"
    }
    WF_application_comments {
        uuid id PK "uuid NOT NULL"
        uuid application_id FK "uuid NOT NULL"
        uuid application_version_id FK "uuid NOT NULL"
        uuid officer_id "uuid NOT NULL"
        character_varying(30) target_type "character varying(30) NOT NULL"
        character_varying(100) target_id "character varying(100) NOT NULL"
        character_varying(255) field_label "character varying(255) NOT NULL"
        text comment_text "text NOT NULL"
        character_varying(20) status "character varying(20) NOT NULL DEFAULT 'OPEN'"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
        timestamp_with_time_zone updated_at "timestamp with time zone NOT NULL"
    }
