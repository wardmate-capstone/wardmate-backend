erDiagram
    DOC_form_templates ||--o{ DOC_form_template_versions : "FK template_id"
    DOC_form_template_versions |o--o{ DOC_user_submissions : "FK template_version_id"
    DOC_application_forms {
        uuid id PK "uuid NOT NULL DEFAULT (uuid_generate_v4())"
        uuid application_id "uuid NOT NULL"
        jsonb form_data "jsonb NOT NULL"
        character_varying(100) created_by "character varying(100) NULL"
        character_varying(100) updated_by "character varying(100) NULL"
        timestamptz created_at "timestamptz NOT NULL"
        timestamptz updated_at "timestamptz NULL"
        boolean is_deleted "boolean NOT NULL DEFAULT FALSE"
        timestamptz deleted_at "timestamptz NULL"
    }
    DOC_approved_qrs {
        uuid id PK "uuid NOT NULL DEFAULT (uuid_generate_v4())"
        uuid application_id UK "uuid NOT NULL"
        uuid submission_id "uuid NOT NULL"
        character_varying(2048) qr_code_value "character varying(2048) NOT NULL"
        bytea qr_image_png "bytea NOT NULL"
        timestamptz generated_at "timestamptz NOT NULL"
    }
    DOC_form_templates {
        uuid id PK "uuid NOT NULL"
        character_varying(50) code UK "character varying(50) NOT NULL"
        character_varying(255) title "character varying(255) NOT NULL"
        text file_docx_url "text NULL"
        boolean is_active "boolean NOT NULL DEFAULT TRUE"
        character_varying(100) created_by "character varying(100) NULL"
        character_varying(100) updated_by "character varying(100) NULL"
        timestamptz created_at "timestamptz NOT NULL"
        timestamptz updated_at "timestamptz NULL"
        boolean is_deleted "boolean NOT NULL DEFAULT FALSE"
        timestamptz deleted_at "timestamptz NULL"
    }
    DOC_generated_documents {
        uuid id PK "uuid NOT NULL DEFAULT (uuid_generate_v4())"
        uuid application_id "uuid NOT NULL"
        uuid submission_id "uuid NULL"
        character_varying(50) document_type "character varying(50) NOT NULL"
        text pdf_blob_url "text NOT NULL"
        character_varying(100) created_by "character varying(100) NULL"
        character_varying(100) updated_by "character varying(100) NULL"
        timestamptz created_at "timestamptz NOT NULL"
        timestamptz updated_at "timestamptz NULL"
        boolean is_deleted "boolean NOT NULL DEFAULT FALSE"
        timestamptz deleted_at "timestamptz NULL"
    }
    DOC_supporting_documents {
        uuid id PK "uuid NOT NULL"
        uuid application_id "uuid NOT NULL"
        character_varying(30) submission_type "character varying(30) NULL"
        character_varying(30) document_copy_type "character varying(30) NULL"
        integer quantity "integer NOT NULL DEFAULT 1"
        uuid checklist_id "uuid NULL"
        character_varying(255) file_name "character varying(255) NOT NULL"
        text blob_url "text NOT NULL"
        bigint file_size_bytes "bigint NULL"
        character_varying(100) content_type "character varying(100) NULL"
        character_varying(100) created_by "character varying(100) NULL"
        character_varying(100) updated_by "character varying(100) NULL"
        timestamptz created_at "timestamptz NOT NULL"
        timestamptz updated_at "timestamptz NULL"
        boolean is_deleted "boolean NOT NULL DEFAULT FALSE"
        timestamptz deleted_at "timestamptz NULL"
    }
    DOC_form_template_versions {
        uuid id PK "uuid NOT NULL"
        character_varying(2048) original_blob_url "character varying(2048) NOT NULL"
        character_varying(64) original_sha256 "character varying(64) NOT NULL"
        jsonb mapping_definition "jsonb NOT NULL"
        uuid template_id FK "uuid NOT NULL"
        integer version_number "integer NOT NULL"
        jsonb schema_definition "jsonb NOT NULL"
        text created_by "text NULL"
        text updated_by "text NULL"
        timestamp_with_time_zone created_at_utc "timestamp with time zone NOT NULL"
        timestamp_with_time_zone updated_at_utc "timestamp with time zone NULL"
        boolean is_deleted "boolean NOT NULL"
        timestamp_with_time_zone deleted_at_utc "timestamp with time zone NULL"
    }
    DOC_user_submissions {
        uuid id PK "uuid NOT NULL DEFAULT (uuid_generate_v4())"
        uuid template_version_id FK "uuid NULL"
        jsonb form_data "jsonb NULL"
        uuid template_id "uuid NOT NULL"
        uuid application_id "uuid NULL"
        uuid checklist_id "uuid NULL"
        uuid applicant_id "uuid NOT NULL"
        character_varying(2048) blob_url "character varying(2048) NOT NULL"
        character_varying(512) file_name "character varying(512) NOT NULL"
        bigint file_size_bytes "bigint NOT NULL"
        character_varying(50) status "character varying(50) NOT NULL"
        character_varying(2000) officer_comment "character varying(2000) NULL"
        uuid reviewed_by_officer_id "uuid NULL"
        timestamptz submitted_at "timestamptz NULL"
        timestamptz reviewed_at "timestamptz NULL"
        character_varying(100) created_by "character varying(100) NULL"
        character_varying(100) updated_by "character varying(100) NULL"
        timestamptz created_at "timestamptz NOT NULL"
        timestamptz updated_at "timestamptz NULL"
        boolean is_deleted "boolean NOT NULL DEFAULT FALSE"
        timestamptz deleted_at "timestamptz NULL"
    }
