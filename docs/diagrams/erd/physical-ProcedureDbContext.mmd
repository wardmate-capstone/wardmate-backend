erDiagram
    CAT_procedure_categories ||--o{ CAT_procedures : "FK category_id"
    CAT_procedures ||--o{ CAT_procedure_versions : "FK procedure_id"
    CAT_procedure_categories {
        integer id PK "integer GENERATED BY DEFAULT AS IDENTITY"
        character_varying(255) category_name "character varying(255) NOT NULL"
        text description "text NULL"
    }
    CAT_procedure_drafts {
        uuid id PK "uuid NOT NULL"
        character_varying(30) status "character varying(30) NOT NULL"
        character_varying(255) blob_name "character varying(255) NOT NULL"
        character_varying(255) pdf_file_name "character varying(255) NOT NULL"
        character_varying(500) original_pdf_url "character varying(500) NOT NULL"
        jsonb payload_json "jsonb NOT NULL"
        jsonb warnings_json "jsonb NOT NULL"
        text extracted_text "text NOT NULL"
        character_varying(100) failure_code "character varying(100) NULL"
        character_varying(255) created_by "character varying(255) NOT NULL"
        character_varying(255) reviewed_by "character varying(255) NULL"
        uuid published_procedure_id "uuid NULL"
        uuid revision "uuid NOT NULL"
        uuid lease_id "uuid NULL"
        timestamp_with_time_zone lease_until "timestamp with time zone NULL"
        integer attempts "integer NOT NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
        timestamp_with_time_zone updated_at "timestamp with time zone NOT NULL"
    }
    CAT_procedures {
        uuid id PK "uuid NOT NULL DEFAULT (gen_random_uuid())"
        integer category_id FK "integer NOT NULL"
        character_varying(50) procedure_code "character varying(50) NOT NULL"
        character_varying(500) title "character varying(500) NOT NULL"
        character_varying(500) original_pdf_url "character varying(500) NULL"
        character_varying(255) pdf_file_name "character varying(255) NULL"
        character_varying(255) issuing_authority "character varying(255) NULL"
        text executing_agency "text NULL"
        character_varying(50) level_of_implementation "character varying(50) NOT NULL DEFAULT 'Cấp Xã'"
        character_varying(255) target_audience "character varying(255) NOT NULL DEFAULT 'Công dân Việt Nam'"
        character_varying(255) fee_summary "character varying(255) NOT NULL DEFAULT 'Miễn phí'"
        character_varying(255) processing_time_summary "character varying(255) NOT NULL DEFAULT '1 ngày'"
        boolean is_active "boolean NOT NULL DEFAULT TRUE"
        text status_change_reason "text NULL"
        jsonb content_payload "jsonb NOT NULL"
        jsonb checklist_schema "jsonb NULL"
        jsonb form_definitions "jsonb NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL DEFAULT (now())"
        timestamp_with_time_zone updated_at "timestamp with time zone NOT NULL DEFAULT (now())"
    }
    CAT_procedure_versions {
        uuid id PK "uuid NOT NULL DEFAULT (gen_random_uuid())"
        uuid procedure_id FK "uuid NOT NULL"
        integer version_number "integer NOT NULL"
        character_varying(100) decision_number "character varying(100) NULL"
        character_varying(500) original_pdf_url "character varying(500) NULL"
        character_varying(255) pdf_file_name "character varying(255) NULL"
        date effective_date "date NOT NULL"
        jsonb snapshot_data "jsonb NOT NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL DEFAULT (now())"
    }
