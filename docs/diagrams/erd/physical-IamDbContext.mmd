erDiagram
    IAM_permissions ||--o{ IAM_role_permissions : "FK permission_id"
    IAM_roles ||--o{ IAM_role_permissions : "FK role_id"
    IAM_wards |o--o{ IAM_users : "FK ward_id"
    IAM_users ||--o{ IAM_refresh_tokens : "FK user_id"
    IAM_users ||--o{ IAM_user_otps : "FK user_id"
    IAM_users ||--o| IAM_user_profiles : "FK user_id"
    IAM_roles ||--o{ IAM_user_roles : "FK role_id"
    IAM_users ||--o{ IAM_user_roles : "FK user_id"
    IAM_users ||--o| IAM_welcome_emails : "FK user_id"
    IAM_permissions {
        integer id PK "integer GENERATED BY DEFAULT AS IDENTITY"
        character_varying(100) permission_code UK "character varying(100) NOT NULL"
        character_varying(255) permission_name "character varying(255) NOT NULL"
        character_varying(50) module "character varying(50) NOT NULL"
    }
    IAM_rbac_audit_logs {
        uuid id PK "uuid NOT NULL"
        uuid actor_user_id "uuid NOT NULL"
        character_varying(100) action "character varying(100) NOT NULL"
        uuid target_user_id "uuid NULL"
        integer role_id "integer NULL"
        integer permission_id "integer NULL"
        jsonb details "jsonb NOT NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
    }
    IAM_roles {
        integer id PK "integer GENERATED BY DEFAULT AS IDENTITY"
        character_varying(50) role_name UK "character varying(50) NOT NULL"
        text description "text NULL"
    }
    IAM_wards {
        uuid id PK "uuid NOT NULL"
        character_varying(50) code UK "character varying(50) NOT NULL"
        character_varying(255) name "character varying(255) NOT NULL"
    }
    IAM_role_permissions {
        integer role_id PK,FK "integer NOT NULL"
        integer permission_id PK,FK "integer NOT NULL"
    }
    IAM_users {
        uuid id PK "uuid NOT NULL"
        uuid security_stamp "uuid NOT NULL"
        text verified_phone_number "text NULL"
        character_varying(100) username UK "character varying(100) NOT NULL"
        character_varying(255) email UK "character varying(255) NOT NULL"
        character_varying(255) password_hash "character varying(255) NOT NULL"
        boolean is_active "boolean NOT NULL DEFAULT TRUE"
        integer_array assigned_categories "integer[] NOT NULL DEFAULT (ARRAY[]::integer[])"
        uuid ward_id FK "uuid NULL"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
        timestamp_with_time_zone updated_at "timestamp with time zone NOT NULL"
    }
    IAM_refresh_tokens {
        uuid id PK "uuid NOT NULL"
        uuid user_id FK "uuid NOT NULL"
        character_varying(500) token UK "character varying(500) NOT NULL"
        timestamp_with_time_zone expires_at "timestamp with time zone NOT NULL"
        boolean is_revoked "boolean NOT NULL DEFAULT FALSE"
        timestamp_with_time_zone created_at "timestamp with time zone NOT NULL"
    }
    IAM_user_otps {
        uuid id PK "uuid NOT NULL"
        uuid user_id FK "uuid NOT NULL"
        character_varying(20) target_phone_number "character varying(20) NULL"
        character_varying(64) otp_hash "character varying(64) NOT NULL"
        character_varying(10) channel "character varying(10) NOT NULL"
        character_varying(30) purpose "character varying(30) NOT NULL"
        timestamp_with_time_zone expires_at_utc "timestamp with time zone NOT NULL"
        integer attempts "integer NOT NULL"
        boolean is_used "boolean NOT NULL"
        timestamp_with_time_zone created_at_utc "timestamp with time zone NOT NULL"
    }
    IAM_user_profiles {
        uuid user_id PK,FK "uuid NOT NULL"
        character_varying(255) full_name "character varying(255) NOT NULL"
        character_varying(20) identity_number UK "character varying(20) NULL"
        character_varying(20) phone_number "character varying(20) NULL"
        date date_of_birth "date NULL"
        character_varying(10) gender "character varying(10) NULL"
        text permanent_address "text NULL"
        text temporary_address "text NULL"
        timestamp_with_time_zone updated_at "timestamp with time zone NOT NULL"
    }
    IAM_user_roles {
        uuid user_id PK,FK "uuid NOT NULL"
        integer role_id PK,FK "integer NOT NULL"
    }
    IAM_welcome_emails {
        uuid id PK "uuid NOT NULL"
        uuid user_id FK,UK "uuid NOT NULL"
        integer attempts "integer NOT NULL"
        timestamp_with_time_zone next_attempt_at_utc "timestamp with time zone NOT NULL"
        timestamp_with_time_zone sent_at_utc "timestamp with time zone NULL"
    }
