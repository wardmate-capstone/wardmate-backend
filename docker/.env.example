IAM_DB_PASSWORD=replace-with-your-local-database-password
PROCEDURE_DB_PASSWORD=replace-with-a-separate-procedure-database-password
JWT_KEY=replace-with-a-random-signing-key-at-least-32-bytes
PGADMIN_DEFAULT_EMAIL=admin@wardmate.com
PGADMIN_DEFAULT_PASSWORD=replace-with-your-local-pgadmin-password

# Optional PDF drafts: Blob is required for uploads; AI/OCR remains disabled until configured.
AZURE_BLOB_CONNECTION_STRING=
PROCEDURE_EXTRACTION_ENABLED=false
PROCEDURE_USE_AI=false
PROCEDURE_OCR_FALLBACK_ENABLED=false
AIOCR_SERVICE_KEY=
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Application Workflow: set a unique local password before using Compose.
WORKFLOW_DB_PASSWORD=

# Required only when enabling the notifications Compose profile. Use a unique password.
NOTIFICATIONS_DB_PASSWORD=

# TASK-27: enable only after IAM key, RabbitMQ credentials and both migrations are configured.
# TASK-31: one random service key >=32 bytes shared by Workflow and Analytics; never commit its value.
ANALYTICS_SERVICE_KEY=
ANALYTICS_JOBS_ENABLED=false
ANALYTICS_LOOKBACK_DAYS=7
ANALYTICS_CRON="15 1 * * *"
NOTIFICATIONS_ENABLED=false
NOTIFICATIONS_SERVICE_KEY=
RABBITMQ_USER=wardmate_admin
RABBITMQ_PASSWORD=

# TASK-26: SMTP STARTTLS (port 587); disabled until provider credentials are available.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_HOST=
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
# SMS remains blocked until a Brandname provider adapter is implemented.

# Optional Gemini provider (real key belongs in secrets).
PROCEDURE_AI_PROVIDER=AzureOpenAI
GEMINI_API_KEY=
GEMINI_MODEL=
