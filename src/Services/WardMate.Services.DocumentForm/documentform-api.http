### DOCX editor workflow; replace IDs and local file paths before running.
@baseUrl = http://localhost:5000/api/document-form
@templateId = REPLACE_TEMPLATE_ID
@submissionId = REPLACE_SUBMISSION_ID
@applicantId = 11111111-1111-4111-8111-111111111111

### Admin create -> copy returned id into templateId (201)
POST {{baseUrl}}/api/v1/form-templates
Content-Type: application/json

{"code":"DOCX_EDITOR_DEMO","title":"Mẫu đơn chính thức"}

### Admin upload original unchanged (200). Replace file path below.
POST {{baseUrl}}/api/v1/form-templates/{{templateId}}/upload-docx
Content-Type: multipart/form-data; boundary=DocumentBoundary

--DocumentBoundary
Content-Disposition: form-data; name="file"; filename="original.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./original.docx
--DocumentBoundary--

### Admin list (200)
GET {{baseUrl}}/api/v1/form-templates?page=1&pageSize=20

### FE metadata: onlineReady=true after upload (200)
GET {{baseUrl}}/api/v1/form-templates/{{templateId}}

### FE imports this binary into Word editor (200)
GET {{baseUrl}}/api/v1/form-templates/{{templateId}}/download-docx

### FE saves exported DOCX; copy submissionId from 201 response
POST {{baseUrl}}/api/v1/citizen/submissions/draft
Content-Type: multipart/form-data; boundary=DocumentBoundary

--DocumentBoundary
Content-Disposition: form-data; name="templateId"

{{templateId}}
--DocumentBoundary
Content-Disposition: form-data; name="applicantId"

{{applicantId}}
--DocumentBoundary
Content-Disposition: form-data; name="file"; filename="edited.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./edited.docx
--DocumentBoundary--

### List saved forms (200)
GET {{baseUrl}}/api/v1/citizen/submissions?applicantId={{applicantId}}

### Reopen metadata (200)
GET {{baseUrl}}/api/v1/citizen/submissions/{{submissionId}}?applicantId={{applicantId}}

### Reopen saved DOCX in editor (200)
GET {{baseUrl}}/api/v1/citizen/submissions/{{submissionId}}/download-docx?applicantId={{applicantId}}

### Save updated exported DOCX (200)
PUT {{baseUrl}}/api/v1/citizen/submissions/{{submissionId}}/draft
Content-Type: multipart/form-data; boundary=DocumentBoundary

--DocumentBoundary
Content-Disposition: form-data; name="applicantId"

{{applicantId}}
--DocumentBoundary
Content-Disposition: form-data; name="file"; filename="edited.docx"
Content-Type: application/vnd.openxmlformats-officedocument.wordprocessingml.document

< ./edited.docx
--DocumentBoundary--

### Confirm completion AFTER save succeeds (200). Later PUT draft -> 400.
POST {{baseUrl}}/api/v1/citizen/submissions/{{submissionId}}/submit
Content-Type: application/json

{"applicantId":"{{applicantId}}"}
