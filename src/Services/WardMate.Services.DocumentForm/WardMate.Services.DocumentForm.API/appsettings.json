{
  "ConnectionStrings": {
    "DocumentDb": "Host=localhost;Port=5432;Database=wardmate_db;Username=wardmate_admin;Password=wardmate_secret"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
