{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=wardmate_db;Username=wardmate_admin;Password=wardmate_secret"
  },
  "Database": {
    "AutoMigrate": false
  },
  "AzureBlob": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "form-templates",
    "MaxFileSizeBytes": 20971520
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "EnableConsoleSink": true,
    "EnableFileSink": true,
    "LogFilePath": "logs/wardmate-documentform-.log",
    "FileSizeLimitMb": 50,
    "RetainedFileCountLimit": 7,
    "ApplicationName": "WardMate.DocumentForm"
  }
}
