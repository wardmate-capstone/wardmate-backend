{
  "AllowedHosts": "*",
  "AuthCookie": { "SameSite": "Strict" },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5433;Database=wardmate_iam_db;Username=wardmate"
  },
  "Database": { "AutoMigrate": true },
  "Jwt": {
    "Issuer": "wardmate",
    "Audience": "wardmate-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AzureBlob": {
    "ConnectionString": "",
    "ContainerName": "wardmate-files",
    "MaxFileSizeBytes": 20971520
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "EnableConsoleSink": true,
    "EnableFileSink": true,
    "LogFilePath": "logs/wardmate-iam-.log",
    "FileSizeLimitMb": 50,
    "RetainedFileCountLimit": 7,
    "ApplicationName": "WardMate.IAM"
  }
}
