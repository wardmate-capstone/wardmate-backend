{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "analytics-v1": { "ClusterId": "analytics-system", "Match": { "Path": "/api/v1/analytics/{**catch-all}" } },
      "notification-deliveries-admin-v1": { "ClusterId": "analytics-system", "Order": -20, "Match": { "Path": "/api/v1/admin/notification-deliveries/{**catch-all}" } },
      "notification-deliveries-admin-root-v1": { "ClusterId": "analytics-system", "Order": -20, "Match": { "Path": "/api/v1/admin/notification-deliveries" } },
      "citizen-feedback-v1": { "ClusterId": "analytics-system", "Order": -20, "Match": { "Path": "/api/v1/citizen/feedback/{**catch-all}" } },
      "document-application-contents": { "ClusterId": "document-form", "Order": -10, "Match": { "Path": "/api/v1/applications/{applicationId}/contents" } },
      "document-application-supporting": { "ClusterId": "document-form", "Order": -10, "Match": { "Path": "/api/v1/applications/{applicationId}/supporting-documents" } },
      "document-application-generate": { "ClusterId": "document-form", "Order": -10, "Match": { "Path": "/api/v1/applications/{applicationId}/generate-pdf" } },
      "document-application-generated": { "ClusterId": "document-form", "Order": -10, "Match": { "Path": "/api/v1/applications/{applicationId}/generated-documents" } },
      "document-application-approved-qr": { "ClusterId": "document-form", "Order": -10, "Match": { "Path": "/api/v1/applications/{applicationId}/approved-qr" } },
      "document-application-approved-qr-image": { "ClusterId": "document-form", "Order": -10, "Match": { "Path": "/api/v1/applications/{applicationId}/approved-qr/image" } },
      "document-supporting": { "ClusterId": "document-form", "Match": { "Path": "/api/v1/supporting-documents/{**catch-all}" } },
      "document-generated": { "ClusterId": "document-form", "Match": { "Path": "/api/v1/generated-documents/{**catch-all}" } },
      "document-officer": { "ClusterId": "document-form", "Match": { "Path": "/api/v1/officer/submissions/{**catch-all}" } },
      "document-public-v1": { "ClusterId": "document-form", "Match": { "Path": "/api/v1/public/{**catch-all}" } },
      "officer-applications-v1": { "ClusterId": "application-workflow", "Match": { "Path": "/api/v1/officer/applications/{**catch-all}" } },
      "officer-applications-root-v1": { "ClusterId": "application-workflow", "Match": { "Path": "/api/v1/officer/applications" } },
      "applications-v1": {
        "ClusterId": "application-workflow",
        "Match": { "Path": "/api/v1/applications/{**catch-all}" }
      },
      "applications-root-v1": {
        "ClusterId": "application-workflow",
        "Match": { "Path": "/api/v1/applications" }
      },
      "procedure-manager-v1": {
        "ClusterId": "procedure-catalog",
        "Match": { "Path": "/api/v1/procedure-manager/{**catch-all}" }
      },
      "procedure-catalog-v1": {
        "ClusterId": "procedure-catalog",
        "Match": { "Path": "/api/v1/procedures/{**catch-all}" }
      },
      "workflow-manager-applications-v1": { "ClusterId": "application-workflow", "Match": { "Path": "/api/v1/manager/applications/{**catch-all}" } },
      "iam-manager-v1": { "ClusterId": "iam", "Match": { "Path": "/api/v1/manager/{**catch-all}" } },
      "iam-admin-v1": { "ClusterId": "iam", "Match": { "Path": "/api/v1/admin/{**catch-all}" } },
      "iam-wards-v1": { "ClusterId": "iam", "Match": { "Path": "/api/v1/wards" } },
      "iam-auth-v1": {
        "ClusterId": "iam",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "iam-users-v1": {
        "ClusterId": "iam",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "iam-accounts-v1": {
        "ClusterId": "iam",
        "Match": { "Path": "/api/v1/accounts/{**catch-all}" }
      },
      "iam-rbac-v1": {
        "ClusterId": "iam",
        "Match": { "Path": "/api/v1/rbac/{**catch-all}" }
      },
      "iam": {
        "ClusterId": "iam",
        "Match": {
          "Path": "/api/iam/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/iam"
          }
        ]
      },
      "procedure-catalog": {
        "ClusterId": "procedure-catalog",
        "Match": {
          "Path": "/api/procedure-catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/procedure-catalog"
          }
        ]
      },
      "application-workflow": {
        "ClusterId": "application-workflow",
        "Match": {
          "Path": "/api/application-workflow/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/application-workflow"
          }
        ]
      },
      "document-form-citizen": {
        "ClusterId": "document-form",
        "Match": { "Path": "/api/v1/citizen/{**catch-all}" }
      },
      "document-form-templates": {
        "ClusterId": "document-form",
        "Match": { "Path": "/api/v1/form-templates/{**catch-all}" }
      },
      "document-form": {
        "ClusterId": "document-form",
        "Match": {
          "Path": "/api/document-form/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/document-form"
          }
        ]
      },
      "ai-ocr": {
        "ClusterId": "ai-ocr",
        "Match": {
          "Path": "/api/ai-ocr/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/ai-ocr"
          }
        ]
      },
      "ai-knowledge-v1": { "ClusterId": "ai-ocr", "Match": { "Path": "/api/v1/ai/knowledge/{**catch-all}" } },
      "ai-ocr-public": {
        "ClusterId": "ai-ocr",
        "Match": { "Path": "/api/v1/ai-ocr/{**catch-all}" }
      },
      "ai-chat-public": {
        "ClusterId": "ai-ocr",
        "Match": { "Path": "/api/v1/ai/chat/{**catch-all}" }
      },
      "analytics-system": {
        "ClusterId": "analytics-system",
        "Match": {
          "Path": "/api/analytics-system/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/analytics-system"
          }
        ]
      }
    },
    "Clusters": {
      "iam": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "procedure-catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "application-workflow": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "document-form": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5004/"
          }
        }
      },
      "ai-ocr": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5005/"
          }
        }
      },
      "analytics-system": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5006/"
          }
        }
      }
    }
  }
}


